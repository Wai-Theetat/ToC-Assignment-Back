# Copy to .env and adjust per environment.
# docker-compose.yml reads these; defaults in the compose file assume local dev.

# --- PostgreSQL credentials shared by the database and backend containers. ---
POSTGRES_USER=TOC
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=bank_app

# --- Browser-visible URL of the FastAPI backend (inlined at BUILD time). ---
# local:      http://localhost:8080
# production: https://api.abasalwah.uk
NEXT_PUBLIC_API_URL=https://api.abasalwah.uk

# --- CORS origin for the backend. ---
# The backend does `allow_origins=[FRONTEND_URL]`, i.e. this is ONE value, not a
# list. When both a local and a tunnelled frontend must reach the API, only the
# wildcard works:
#   local only : http://localhost:3000
#   both       : *
FRONTEND_URL=*